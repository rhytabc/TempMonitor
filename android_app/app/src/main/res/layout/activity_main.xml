<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 状态卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp" app:cardElevation="2dp">
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:padding="12dp" android:background="#FFFFFF">
            <TextView android:id="@+id/status_text"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="○ Not Connected"
                android:textColor="#999999" android:textSize="14sp" />
            <TextView android:id="@+id/mode_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AIR" android:textColor="#F39C12" android:textSize="13sp"
                android:fontFamily="sans-serif-medium" android:layout_marginEnd="8dp" />
            <ToggleButton android:id="@+id/mode_btn"
                android:layout_width="42dp" android:layout_height="24dp"
                android:background="#E8E8E8" android:minWidth="0dp" android:minHeight="0dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 温度卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp" app:cardElevation="3dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:background="#FFFFFF" android:paddingTop="32dp" android:paddingBottom="20dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center">
                <TextView android:id="@+id/temp_text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--.-" android:textColor="#CCCCCC" android:textSize="100sp" android:fontFamily="sans-serif-thin" />
                <TextView android:id="@+id/temp_unit"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="°C" android:textColor="#CCCCCC" android:textSize="40sp"
                    android:layout_marginTop="-28dp" />
            </LinearLayout>
            <TextView android:id="@+id/desc_text"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="" android:textColor="#888888"
                android:textSize="13sp" android:paddingHorizontal="24dp" android:paddingTop="8dp" />
            <TextView android:id="@+id/update_text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#BBBBBB" android:textSize="11sp" android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- MAX / MIN -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="12dp">
        <androidx.cardview.widget.CardView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="#FFFFFF" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MAXIMUM" android:textColor="#AAAAAA" android:textSize="10sp"
                    android:letterSpacing="0.3" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/max_text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="--.-°"
                    android:textColor="#E74C3C" android:textSize="36sp"
                    android:fontFamily="sans-serif-thin" android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            app:cardCornerRadius="12dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="#FFFFFF" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MINIMUM" android:textColor="#AAAAAA" android:textSize="10sp"
                    android:letterSpacing="0.3" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/min_text" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="--.-°"
                    android:textColor="#5DADE2" android:textSize="36sp"
                    android:fontFamily="sans-serif-thin" android:layout_marginTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- 预警阈值 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:background="#FFFFFF" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ALARM THRESHOLD" android:textColor="#AAAAAA" android:textSize="10sp"
                android:letterSpacing="0.3" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/alarm_low" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="&lt; 0°"
                    android:textColor="#5DADE2" android:textSize="24sp" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="   —   " android:textColor="#DDDDDD" android:textSize="24sp" />
                <TextView android:id="@+id/alarm_high" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="&gt; 35°"
                    android:textColor="#E74C3C" android:textSize="24sp" android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 曲线图 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp" app:cardElevation="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#FFFFFF" android:padding="4dp">
            <com.tempmonitor.ChartView android:id="@+id/chart_view"
                android:layout_width="match_parent" android:layout_height="280dp" android:layout_margin="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="Connect to TempMonitor WiFi"
        android:textColor="#CCCCCC" android:textSize="11sp" android:layout_marginTop="4dp" />

</LinearLayout>
</ScrollView>
